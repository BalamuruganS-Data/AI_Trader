# Cloud deployment environment variables
# Copy this file to .env (for local testing) or set these in your cloud platform's environment settings

# Email configuration
EMAIL_USERNAME=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENTS=recipient@example.com,another@example.com

# Broker configuration
BROKER_PROVIDER=none
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_ACCESS_TOKEN=
BROKER_USER_ID=

# Trading settings
WATCHLIST=RELIANCE.NS,TCS.NS,HDFCBANK.NS,INFY.NS
LIVE_TRADING=False
DEFAULT_CAPITAL=100000.0
DAILY_TRADE_AMOUNT=None

# Flask settings
FLASK_ENV=production
PORT=5000
